
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SSLC Paper Hub</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f1f4fb;
  color: #172033;
}

header {
  background: #172554;
  color: white;
  text-align: center;
  padding: 25px 12px;
}

header h1 {
  margin: 0 0 8px;
}

.tabs {
  display: flex;
  justify-content: center;
  gap: 12px;
  padding: 20px 10px;
}

.tabs button {
  padding: 13px 22px;
  border: 0;
  border-radius: 9px;
  background: #dbeafe;
  color: #172554;
  font-weight: bold;
  cursor: pointer;
}

.tabs button.active {
  background: #2563eb;
  color: white;
}

.paper-box {
  display: none;
  background: white;
  margin: 10px auto 30px;
  padding: 18px;
  width: 95%;
  max-width: 1100px;
  border-radius: 12px;
  box-shadow: 0 3px 15px #00000012;
  overflow-x: auto;
}

.paper-box.show {
  display: block;
}

h2 {
  color: #1d4ed8;
  text-align: center;
}

table {
  width: 100%;
  min-width: 650px;
  border-collapse: collapse;
}

th, td {
  border: 1px solid #d5dbea;
  padding: 13px 10px;
  text-align: center;
}

th {
  background: #1e3a8a;
  color: white;
}

tr:nth-child(even) {
  background: #f4f7ff;
}

a {
  display: inline-block;
  background: #2563eb;
  color: white;
  padding: 8px 10px;
  margin: 3px;
  border-radius: 6px;
  text-decoration: none;
  font-size: 13px;
}

a:hover {
  background: #1e40af;
}

footer {
  text-align: center;
  padding: 20px;
  color: #64748b;
}
</style>
</head>

<body>

<header>
  <h1>📚 SSLC Paper Hub</h1>
  <p>Previous Year & Model Question Papers</p>
</header>

<div class="tabs">
  <button class="active" onclick="showBoard('state', this)">
    STATE BOARD
  </button>

  <button onclick="showBoard('cbse', this)">
    CBSE
  </button>
</div>

<div id="state" class="paper-box show">
  <h2>STATE BOARD – Karnataka</h2>

  <table>
    <tr>
      <th>Subject</th>
      <th>Previous Year Question Papers</th>
      <th>Model Question Papers</th>
    </tr>

    <tr>
      <td>Kannada</td>
      <td><a href="STATE_KANNADA_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="STATE_KANNADA_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>English</td>
      <td><a href="STATE_ENGLISH_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="STATE_ENGLISH_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Hindi</td>
      <td><a href="STATE_HINDI_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="STATE_HINDI_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Mathematics</td>
      <td><a href="STATE_MATHS_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="STATE_MATHS_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Science</td>
      <td><a href="STATE_SCIENCE_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="STATE_SCIENCE_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Social Science</td>
      <td><a href="STATE_SOCIAL_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="STATE_SOCIAL_MODEL_PDF_URL">PDF 1</a></td>
    </tr>
  </table>
</div>

<div id="cbse" class="paper-box">
  <h2>CBSE – English Medium</h2>

  <table>
    <tr>
      <th>Subject</th>
      <th>Previous Year Question Papers</th>
      <th>Model Question Papers</th>
    </tr>

    <tr>
      <td>English</td>
      <td><a href="CBSE_ENGLISH_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="CBSE_ENGLISH_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Hindi</td>
      <td><a href="CBSE_HINDI_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="CBSE_HINDI_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Mathematics</td>
      <td><a href="CBSE_MATHS_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="CBSE_MATHS_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Science</td>
      <td><a href="CBSE_SCIENCE_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="CBSE_SCIENCE_MODEL_PDF_URL">PDF 1</a></td>
    </tr>

    <tr>
      <td>Social Science</td>
      <td><a href="CBSE_SOCIAL_PREVIOUS_PDF_URL">PDF 1</a></td>
      <td><a href="CBSE_SOCIAL_MODEL_PDF_URL">PDF 1</a></td>
    </tr>
  </table>
</div>

<footer>
  © 2026 SSLC Paper Hub
</footer>

<script>
function showBoard(board, button) {
  document.querySelectorAll(".paper-box").forEach(box => {
    box.classList.remove("show");
  });

  document.getElementById(board).classList.add("show");

  document.querySelectorAll(".tabs button").forEach(btn => {
    btn.classList.remove("active");
  });

  button.classList.add("active");
}
</script>

</body>
</html>
