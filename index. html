<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SSLC Paper Hub</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f2f5ff;
  color: #18213a;
}

header {
  background: linear-gradient(135deg, #172554, #2563eb);
  color: white;
  padding: 28px 16px;
  text-align: center;
}

header h1 {
  margin: 0 0 10px;
}

header p {
  margin: 0;
  color: #dbeafe;
}

.container {
  max-width: 900px;
  margin: auto;
  padding: 20px 14px;
}

.search {
  width: 100%;
  padding: 15px;
  border: 2px solid #dbeafe;
  border-radius: 12px;
  font-size: 16px;
  margin-bottom: 20px;
  outline-color: #2563eb;
}

.filters {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

select {
  flex: 1;
  min-width: 0;
  padding: 12px 6px;
  border-radius: 9px;
  border: 1px solid #cbd5e1;
  background: white;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 15px;
}

.card {
  background: white;
  padding: 18px;
  border-radius: 14px;
  box-shadow: 0 3px 12px #0000000b;
  border: 1px solid #e5e7eb;
}

.card h3 {
  margin-top: 0;
  color: #1d4ed8;
}

.tag {
  display: inline-block;
  background: #dbeafe;
  color: #1e40af;
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 12px;
}

button, .view {
  display: inline-block;
  background: #2563eb;
  color: white;
  padding: 10px 14px;
  border: none;
  border-radius: 8px;
  text-decoration: none;
  cursor: pointer;
  margin-top: 10px;
}

.view:hover, button:hover {
  background: #1d4ed8;
}

.empty {
  text-align: center;
  padding: 25px;
  display: none;
}

footer {
  text-align: center;
  padding: 24px;
  color: #64748b;
}

</style>
</head>

<body>

<header>
  <h1>📚 SSLC PAPER HUB</h1>
  <p>Your Free SSLC Exam Preparation Platform</p>
</header>

<main class="container">

  <h2>🔎 Find Question Papers</h2>

  <input
    id="search"
    class="search"
    type="search"
    placeholder="Search subject, year or exam..."
    aria-label="Search question papers"
  >

  <div class="filters">
    <select id="subject" aria-label="Filter by subject">
      <option value="">All Subjects</option>
      <option>Kannada</option>
      <option>English</option>
      <option>Hindi</option>
      <option>Mathematics</option>
      <option>Science</option>
      <option>Social Science</option>
    </select>

    <select id="year" aria-label="Filter by year">
      <option value="">All Years</option>
      <option>2026</option>
      <option>2025</option>
      <option>2024</option>
      <option>2023</option>
      <option>2022</option>
      <option>2021</option>
      <option>2020</option>
    </select>
  </div>

  <div class="grid" id="papers"></div>

  <div class="empty" id="empty">
    <h3>😕 No papers found</h3>
    <p>Try another subject, year or search term.</p>
  </div>

</main>

<footer>
  <p>SSLC PAPER HUB © 2026</p>
  <p>Free study resources for students ❤️</p>
</footer>

<script>

// Add verified public PDF or official source links here.
// Replace each example URL with a real paper link.

const questionPapers = [
  {
    subject: "Mathematics",
    year: "2026",
    exam: "Model Question Paper",
    url: ""
  },
  {
    subject: "Science",
    year: "2026",
    exam: "Preparatory Exam",
    url: ""
  },
  {
    subject: "Kannada",
    year: "2025",
    exam: "Annual Exam",
    url: ""
  },
  {
    subject: "English",
    year: "2025",
    exam: "Model Question Paper",
    url: ""
  },
  {
    subject: "Social Science",
    year: "2024",
    exam: "Annual Exam",
    url: ""
  },
  {
    subject: "Hindi",
    year: "2024",
    exam: "Practice Paper",
    url: ""
  }
];

const search = document.getElementById("search");
const subject = document.getElementById("subject");
const year = document.getElementById("year");
const papers = document.getElementById("papers");
const empty = document.getElementById("empty");

function renderPapers() {
  const query = search.value.toLowerCase().trim();

  const filtered = questionPapers.filter(paper => {
    const matchesSearch =
      (paper.subject + " " + paper.year + " " + paper.exam)
      .toLowerCase().includes(query);

    const matchesSubject =
      !subject.value || paper.subject === subject.value;

    const matchesYear =
      !year.value || paper.year === year.value;

    return matchesSearch && matchesSubject && matchesYear;
  });

  papers.innerHTML = "";

  filtered.forEach(paper => {
    const card = document.createElement("article");
    card.className = "card";

    const title = document.createElement("h3");
    title.textContent = "📄 " + paper.subject;

    const details = document.createElement("p");
    details.textContent = paper.year + " • " + paper.exam;

    const tag = document.createElement("span");
    tag.className = "tag";
    tag.textContent = paper.exam;

    card.append(title, details, tag);

    if (paper.url) {
      const link = document.createElement("a");
      link.className = "view";
      link.href = paper.url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = "View Question Paper ↗";
      card.appendChild(link);
    } else {
      const note = document.createElement("p");
      note.textContent = "Paper link will be added soon.";
      card.appendChild(note);
    }

    papers.appendChild(card);
  });

  empty.style.display = filtered.length ? "none" : "block";
}

search.addEventListener("input", renderPapers);
subject.addEventListener("change", renderPapers);
year.addEventListener("change", renderPapers);

renderPapers();

</script>
</body>
</html>
