<title>SSLC Paper Hub</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #eef2ff;
  color: #172554;
}

header {
  background: linear-gradient(135deg, #111827, #3730a3);
  color: white;
  text-align: center;
  padding: 35px 15px;
}

header h1 {
  font-size: 30px;
  margin: 0;
}

header p {
  color: #dbeafe;
}

.tabs {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
  padding: 25px 10px;
}

.tabs button {
  border: none;
  padding: 14px 28px;
  border-radius: 10px;
  background: white;
  color: #1e3a8a;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 3px 10px #00000015;
}

.tabs button.active {
  background: #2563eb;
  color: white;
}

.paper-box {
  display: none;
  width: 95%;
  max-width: 1100px;
  margin: 10px auto 35px;
  padding: 22px;
  background: white;
  border-radius: 15px;
  box-shadow: 0 5px 20px #00000012;
  overflow-x: auto;
}

.paper-box.show {
  display: block;
}

h2 {
  text-align: center;
  color: #3730a3;
}

table {
  width: 100%;
  min-width: 680px;
  border-collapse: collapse;
  margin-top: 20px;
}

th, td {
  border: 1px solid #dbeafe;
  padding: 14px 10px;
  text-align: center;
}

th {
  background: #1e3a8a;
  color: white;
}

tr:nth-child(even) {
  background: #f8faff;
}

.pdf-btn {
  display: inline-block;
  padding: 9px 11px;
  margin: 4px;
  border-radius: 7px;
  text-decoration: none;
  color: white;
  font-size: 13px;
  font-weight: bold;
}

.view-btn {
  background: #2563eb;
}

.download-btn {
  background: #16a34a;
}

footer {
  background: #111827;
  color: white;
  text-align: center;
  padding: 20px;
  margin-top: 30px;
}

@media(max-width:600px) {
  header h1 {
    font-size: 24px;
  }

  .paper-box {
    padding: 12px;
  }

  .tabs button {
    padding: 12px 18px;
  }
}
</style>
</head>

